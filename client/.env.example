# PLVX Frontend Configuration
# Copy this file to .env and fill in your values

# =====================================================
# Contract Configuration
# =====================================================

# PLVX Contract Hash (without "hash-" prefix)
REACT_APP_CONTRACT_HASH=your-contract-hash-here

# Contract Package Hash (without "hash-" prefix)
REACT_APP_CONTRACT_PACKAGE_HASH=your-package-hash-here

# Network: "casper" for mainnet, "casper-test" for testnet
REACT_APP_NETWORK=casper-test

# =====================================================
# CSPR.cloud Configuration
# =====================================================

# CSPR.cloud API Key
# Get your API key from: https://cspr.cloud
REACT_APP_CSPR_CLOUD_API_KEY=your-api-key-here

# =====================================================
# Optional Configuration
# =====================================================

# Node Address (optional, uses default CSPR.cloud nodes)
# REACT_APP_NODE_ADDRESS=http://NODE_IP:7777

# Chain Name (optional, defaults to network setting)
# REACT_APP_CHAIN_NAME=casper-test

# Gas Price (optional, defaults to 1)
# REACT_APP_GAS_PRICE=1

# TTL (Time To Live) for deploys in milliseconds (optional, defaults to 1800000 - 30 minutes)
# REACT_APP_DEPLOY_TTL=1800000
